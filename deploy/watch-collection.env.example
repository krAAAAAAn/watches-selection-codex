# Copy outside the public web directory; use a real private password locally.
# Never commit the resulting file or share its password in chat.
COLLECTION_PASSWORD=replace-with-your-private-password
COLLECTION_DATA_DIR=/var/lib/watch-collection
HOST=127.0.0.1
PORT=8765
# Set to 1 when a reverse proxy serves the application over HTTPS.
COLLECTION_SECURE_COOKIES=1

# Optional AI: leave these commented for URL import without AI.
# Full OpenAI-compatible Chat Completions endpoint, not just the base URL.
# AI_ENDPOINT=https://api.openai.com/v1/chat/completions
# AI_MODEL=your-provider-model-name
# AI_API_KEY=your-private-provider-key
# Local providers may omit AI_API_KEY:
# AI_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
# AI_MODEL=your-installed-local-model
