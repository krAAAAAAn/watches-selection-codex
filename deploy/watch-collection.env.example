# Copy outside the public web directory; use a real private password locally.
# Never commit the resulting file or share its password in chat.
COLLECTION_PASSWORD=replace-with-your-private-password
COLLECTION_DATA_DIR=/var/lib/watch-collection
HOST=127.0.0.1
PORT=8765
# Set to 1 when a reverse proxy serves the application over HTTPS.
COLLECTION_SECURE_COOKIES=1
